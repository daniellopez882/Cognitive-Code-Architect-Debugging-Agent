# Copy to .env and fill in. Never commit the result.
#
# The previous version listed GitHub and GitLab tokens, cache and size settings
# and a log level. The code reads none of them; the two below are what it uses.

# Read by the Google model client on the first model call. --help, cloning and
# the static stages run without it.
GOOGLE_API_KEY=

# The model used for the logic review and for fix proposals.
# REVIEW_MODEL=gemini-2.0-flash-exp
